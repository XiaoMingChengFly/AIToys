# 复制成 deploy/.env 再改。不要提交 deploy/.env。
# 生成随机值：openssl rand -hex 32

# 访问域名，先把它的 A 记录指向服务器 IP；Caddy 会自动申请 HTTPS 证书
DOMAIN=feishu.example.com

# 登录会话签名密钥
BETTER_AUTH_SECRET=
# 数据库密码（只用字母和数字）。数据库第一次启动后再改这里不会生效，要先在库里改密码
POSTGRES_PASSWORD=
# zero-cache 管理密码
ZERO_ADMIN_PASSWORD=

# 可选：全内网部署、Webhook 接收方也在内网时设成 true
# WEBHOOK_ALLOW_PRIVATE=false
# 可选：没有域名、只在本机或内网用 HTTP 试跑时，两项一起设（地址换成实际访问用的）
# SITE_ADDRESS=:80
# PUBLIC_URL=http://192.168.1.10
