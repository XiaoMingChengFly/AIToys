{
  "name": "feishu-project",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "typecheck": "turbo run typecheck",
    "check": "biome check .",
    "db:generate": "pnpm --filter @fp/db db:generate && pnpm --filter @fp/sync generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  }
}
