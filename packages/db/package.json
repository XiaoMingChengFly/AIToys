{
  "name": "@fp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/migrate.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fp/engine": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "drizzle-kit": "0.31.11",
    "vitest": "3.2.4"
  }
}
